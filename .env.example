# Copy this file to .env before running `npm run docker:up`.
# Keep the real file out of version control. Use a password manager or a
# deployment secret store for provider credentials and the access token.

NODE_ENV=production
XIAOYI_ACCESS_TOKEN=
XIAOYI_INVITATIONS_REQUIRED=0
XIAOYI_AUTH_SESSION_DAYS=7

# Public reverse-proxy URL. The default Compose entrypoint is port 8080.
XIAOYI_ALLOWED_ORIGIN=http://127.0.0.1:8080
XIAOYI_HTTP_PORT=8080
XIAOYI_HTTP_BIND=127.0.0.1

# For public HTTPS, place fullchain.pem and privkey.pem under deploy/tls,
# set XIAOYI_ALLOWED_ORIGIN to the public https:// origin, then run docker:up:https.
XIAOYI_HTTPS_PORT=443

# Queue, rate limiting, and backup policy.
XIAOYI_MAX_CONCURRENT_RUNS=1
XIAOYI_RATE_LIMIT_PER_MINUTE=120
XIAOYI_BACKUP_INTERVAL_MINUTES=60
XIAOYI_BACKUP_RETENTION=30

# Leave empty unless a mounted NAS/backup directory is available.
XIAOYI_REMOTE_BACKUP_DIR=
XIAOYI_MONTHLY_TOKEN_LIMIT=
XIAOYI_MONTHLY_BUDGET_MICROS=
XIAOYI_AUDIT_RETENTION_DAYS=180
XIAOYI_USAGE_RETENTION_DAYS=365

# Optional outbound alert integration. HTTPS is required.
XIAOYI_ALERT_WEBHOOK_URL=

# JSON values are intentionally empty in the example. Inject provider keys
# through your secret manager instead of committing them here.
XIAOYI_MODEL_PRICING_JSON={}
XIAOYI_FALLBACK_PROVIDERS_JSON=[]
XIAOYI_SERVER_PROVIDERS_JSON=[]
